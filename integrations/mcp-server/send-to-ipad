#!/usr/bin/env python3
"""Send a local file to the iPad through the relay.

    send-to-ipad paper.pdf
    send-to-ipad notes.md --title "Reading notes" --tag research
    send-to-ipad https://arxiv.org/pdf/2401.00001

**Why this exists rather than an MCP tool.** The MCP server runs on the relay,
which is somewhere else and cannot read your disk. Anything that reads a local
file has to run locally — so this does, and Claude Code can call it because
Claude Code runs on the same machine as the file. A hosted tool would have to
take the bytes base64-encoded through a JSON-RPC call, which caps out around
three megabytes and doubles the size on the way.

Markdown goes as text, exactly as `send_to_ipad` sends it. Anything else is
uploaded as `document.pdf` in two steps — declare, then upload — so a large file
streams rather than sitting in memory, and a bundle half-uploaded is invisible
until its last byte lands.

Configuration comes from the environment, or from ~/.pencil-loop-relay-tokens:

    PENCIL_RELAY_URL      https://your-relay.example.com
    PENCIL_DEVICE_TOKEN   the token the relay printed when it was deployed
"""

from __future__ import annotations

import argparse
import hashlib
import json
import mimetypes
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

DEFAULT_TOKEN_FILE = Path.home() / ".pencil-loop-relay-tokens"
CHUNK = 1024 * 1024


def die(message: str) -> None:
    print(f"send-to-ipad: {message}", file=sys.stderr)
    raise SystemExit(1)


def settings() -> tuple[str, str]:
    """The relay's address and token, from the environment or the token file."""
    values = dict(os.environ)
    if DEFAULT_TOKEN_FILE.is_file():
        for line in DEFAULT_TOKEN_FILE.read_text().splitlines():
            key, _, value = line.partition("=")
            values.setdefault(key.strip(), value.strip())

    url = (values.get("PENCIL_RELAY_URL") or "").strip()
    token = (values.get("PENCIL_DEVICE_TOKEN") or "").strip()
    if not url:
        die("set PENCIL_RELAY_URL, or put it in ~/.pencil-loop-relay-tokens")
    if not token:
        die("set PENCIL_DEVICE_TOKEN, or put it in ~/.pencil-loop-relay-tokens")
    if not url.startswith("https://"):
        url = "https://" + url.removeprefix("http://")
    return url.rstrip("/"), token


def request(url: str, token: str, method: str, path: str, body=None, content_type=None):
    data = body
    if isinstance(body, (dict, list)):
        data = json.dumps(body).encode()
        content_type = "application/json"
    req = urllib.request.Request(url + path, data=data, method=method)
    req.add_header("Authorization", f"Bearer {token}")
    if content_type:
        req.add_header("Content-Type", content_type)
    try:
        with urllib.request.urlopen(req) as response:
            raw = response.read()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as error:
        detail = error.read().decode(errors="replace")
        try:
            detail = json.loads(detail).get("message", detail)
        except ValueError:
            pass
        die(f"{method} {path} -> {error.code}: {detail}")
    except urllib.error.URLError as error:
        die(f"could not reach the relay: {error.reason}")


def sha256_of(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(CHUNK), b""):
            digest.update(chunk)
    return digest.hexdigest()


def fetch(source: str) -> tuple[Path, str]:
    """Download a URL to a temporary file, so a link works like a local file."""
    import tempfile

    name = source.rstrip("/").rsplit("/", 1)[-1] or "document.pdf"
    handle = tempfile.NamedTemporaryFile(suffix="-" + name, delete=False)
    try:
        with urllib.request.urlopen(source) as response:
            while chunk := response.read(CHUNK):
                handle.write(chunk)
    except (urllib.error.URLError, ValueError) as error:
        die(f"could not fetch {source}: {error}")
    handle.close()
    return Path(handle.name), name


def looks_like_markdown(path: Path) -> bool:
    if path.suffix.lower() in {".md", ".markdown", ".txt"}:
        return True
    guessed, _ = mimetypes.guess_type(path.name)
    return guessed == "text/markdown"


def title_for(path: Path, given: str | None, original: str | None) -> str:
    if given:
        return given
    stem = Path(original or path.name).stem
    stem = stem.split("-", 1)[-1] if stem[:4].isdigit() else stem
    return stem.replace("-", " ").replace("_", " ").strip() or "Untitled"


def main() -> None:
    parser = argparse.ArgumentParser(description="Send a file to the iPad.")
    parser.add_argument("source", help="a local path, or an https URL")
    parser.add_argument("--title", help="defaults to the file name")
    parser.add_argument("--tag", action="append", dest="tags", default=[])
    args = parser.parse_args()

    url, token = settings()

    original: str | None = None
    if args.source.startswith(("http://", "https://")):
        path, original = fetch(args.source)
        source_url = args.source
    else:
        path = Path(args.source).expanduser()
        source_url = None
        if not path.is_file():
            die(f"no such file: {path}")

    title = title_for(path, args.title, original)

    if looks_like_markdown(path):
        body = {
            "content": path.read_text(encoding="utf-8", errors="replace"),
            "title": title,
            "tags": args.tags,
        }
        result = request(url, token, "POST", "/v1/documents", body)
        print(f"sent  {result['folderName']}  ({title})")
        return

    # Anything else goes as the PDF the reader renders. Declared first so the
    # bundle is invisible until the last byte lands, and so a file too large
    # for the relay is refused before it is uploaded rather than after.
    size = path.stat().st_size
    declared = {
        "title": title,
        "tags": args.tags,
        "sourceFormat": "pdf",
        "sourceURL": source_url,
        "expectedFiles": [
            {"name": "document.pdf", "bytes": size, "sha256": sha256_of(path)}
        ],
    }
    result = request(url, token, "POST", "/v1/documents", declared)
    folder = result["folderName"]

    with path.open("rb") as handle:
        request(
            url,
            token,
            "PUT",
            f"/v1/documents/{folder}/files/document.pdf",
            handle.read(),
            "application/pdf",
        )

    print(f"sent  {folder}  ({title}, {size / 1_000_000:.1f}MB)")


if __name__ == "__main__":
    main()
